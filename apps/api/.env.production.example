SUPABASE_JWT_ISSUER=https://PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECRET_MANAGER
WEB_APP_URL=https://app.example.co.uk/
RESEND_API_KEY=REPLACE_IN_SECRET_MANAGER
EMAIL_FROM_ADDRESS=no-reply@example.co.uk
EMAIL_FROM_NAME=BusinessOS
EMAIL_REPLY_TO=support@example.co.uk
RESEND_WEBHOOK_SECRET=REPLACE_IN_SECRET_MANAGER
INVITATION_TOKEN_SECRET=REPLACE_WITH_INDEPENDENT_64_BYTE_SECRET
PORTAL_INVITATION_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_SECRET
INTEGRATION_SIGNING_MASTER_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_SECRET
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PLATFORM_ACCOUNT_ID=acct_REPLACE
STRIPE_API_VERSION=2026-07-29.dahlia
RELEASE_SHA=REPLACE_WITH_COMMIT_SHA
OPERATIONS_HEALTH_TOKEN=REPLACE_WITH_INDEPENDENT_64_BYTE_SECRET
INCIDENT_RESPONSE_EMAIL=security@example.co.uk
SENTRY_DSN=https://REPLACE.ingest.sentry.io/REPLACE
AXIOM_TOKEN=REPLACE_IN_SECRET_MANAGER
SUPABASE_PITR_ENABLED=true
