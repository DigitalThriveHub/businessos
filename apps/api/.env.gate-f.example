# Gate F additions. Put real values in the deployment secret manager, never in Git.

# Exact reviewed number of reverse proxies between the internet and the API.
# Production rejects zero so rate limiting cannot silently key every user to
# the load balancer address. Common single-WAF deployments use 1.
TRUST_PROXY_HOPS=1

# Independent high-entropy secret (for example, 48 random bytes encoded as hex).
INTEGRATION_SIGNING_MASTER_SECRET=replace-with-independent-random-secret
INTEGRATION_WEBHOOK_TOLERANCE_SECONDS=300

# Use Stripe test-mode values in staging and live-mode values only in production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLATFORM_ACCOUNT_ID=acct_replace_me

# Pin the API version configured for the Stripe account. Do not use "latest".
STRIPE_API_VERSION=YYYY-MM-DD.version

# Existing Gate D value. Must be the trusted web origin with a trailing slash.
WEB_APP_URL=https://app.example.co.uk/
