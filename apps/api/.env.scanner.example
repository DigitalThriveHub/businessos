# Document scanning is fail-closed. Keep disabled until the migration, private
# ClamAV service and backend-only Supabase service role secret are deployed.
DOCUMENT_SCANNER_ENABLED=false

# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-secret-manager-reference

# Choose exactly one transport. Prefer a Unix socket when both services share a
# host; otherwise use a private network hostname that is not internet-routable.
CLAMAV_SOCKET_PATH=/run/clamav/clamd.ctl
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

DOCUMENT_SCANNER_POLL_INTERVAL_MS=5000
DOCUMENT_SCANNER_LEASE_SECONDS=300
DOCUMENT_SCANNER_STORAGE_TIMEOUT_MS=120000
DOCUMENT_SCANNER_MAX_FILE_BYTES=52428800
DOCUMENT_SCANNER_WORKER_ID_PREFIX=businessos-api
CLAMAV_CONNECT_TIMEOUT_MS=5000
CLAMAV_SCAN_TIMEOUT_MS=120000
