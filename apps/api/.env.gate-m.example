# Gate M has a genuine no-provider mode. Clean documents, manual review,
# checklist control, My Work, Control Tower and ROI evidence still operate.
DOCUMENT_INTELLIGENCE_ENABLED=false

# Live extraction only. Reuse the server-only OpenAI project key already used
# by Gate K, or keep Gate K disabled and configure only this worker.
# OPENAI_API_KEY=sk-proj-replace-with-a-new-project-key
# DOCUMENT_INTELLIGENCE_MODEL=replace-with-an-approved-vision-model

DOCUMENT_INTELLIGENCE_POLL_INTERVAL_MS=5000
DOCUMENT_INTELLIGENCE_LEASE_SECONDS=300
DOCUMENT_INTELLIGENCE_TIMEOUT_MS=60000
DOCUMENT_INTELLIGENCE_MAX_OUTPUT_TOKENS=2400
DOCUMENT_INTELLIGENCE_MAX_FILE_BYTES=20971520

# Optional cost-rate evidence in the organisation's minor currency units per
# one million tokens. Zero means "not configured", never a false free claim.
DOCUMENT_INTELLIGENCE_INPUT_COST_PER_MILLION_MINOR=0
DOCUMENT_INTELLIGENCE_OUTPUT_COST_PER_MILLION_MINOR=0

# Intelligence is downstream of the existing private ClamAV pipeline.
DOCUMENT_SCANNER_ENABLED=false
