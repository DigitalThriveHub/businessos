# Cost-safe default: AI generation is locked and no provider call can occur.
# Workload cards and all non-AI BusinessOS modules remain operational.
OPENAI_AGENT_ENABLED=false

# Paid/live mode only. Put real values in apps/api/.env locally or in the
# production secret manager. Never commit a real provider key.
# OPENAI_AGENT_ENABLED=true
# OPENAI_API_KEY=sk-proj-replace-with-a-new-project-key
# OPENAI_AGENT_MODEL=replace-with-an-approved-project-model

# Provider timeout and bounded structured response size.
OPENAI_AGENT_TIMEOUT_MS=30000
OPENAI_AGENT_MAX_OUTPUT_TOKENS=1800
