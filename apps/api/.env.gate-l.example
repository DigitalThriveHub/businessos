# Gate L is fail-closed until all three live flags are enabled deliberately.
GATE_L_LIVE_ENABLED=false
GATE_L_SYNC_ENABLED=false
COMMUNICATION_DELIVERY_ENABLED=false

# Worker controls. These defaults are safe for a single API replica; database
# leases prevent duplicate work when more replicas are added.
GATE_L_SYNC_POLL_INTERVAL_MS=15000
GATE_L_SYNC_MINIMUM_AGE_SECONDS=60
GATE_L_SYNC_LEASE_SECONDS=180
COMMUNICATION_DELIVERY_POLL_INTERVAL_MS=5000
COMMUNICATION_DELIVERY_LEASE_SECONDS=120
COMMUNICATION_DELIVERY_WORKER_ID_PREFIX=businessos-api

# Store this value only in apps/api/.env for local development or in the
# production secret manager. The database and browser receive opaque references
# such as "microsoft-main" and "whatsapp-main", never these credentials.
#
# Microsoft 365 + WhatsApp example (one physical line is required by dotenv):
GATE_L_PROVIDER_SECRETS_JSON='{"microsoft-main":{"provider":"MICROSOFT_365","tenantId":"REPLACE","clientId":"REPLACE","clientSecret":"REPLACE","mailboxUserId":"shared-mailbox@example.co.uk","webhookClientState":"REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS"},"whatsapp-main":{"provider":"WHATSAPP_BUSINESS","graphApiVersion":"vREPLACE.0","accessToken":"REPLACE","appSecret":"REPLACE_WITH_META_APP_SECRET","phoneNumberId":"REPLACE","verifyToken":"REPLACE_WITH_16_OR_MORE_RANDOM_CHARACTERS","defaultTemplateName":"businessos_update","defaultTemplateLanguage":"en_GB"}}'

# Google Workspace alternative for the email/calendar reference. Replace the
# value above rather than defining GATE_L_PROVIDER_SECRETS_JSON twice.
# GATE_L_PROVIDER_SECRETS_JSON='{"google-main":{"provider":"GOOGLE_WORKSPACE","clientId":"REPLACE","clientSecret":"REPLACE","refreshToken":"REPLACE","mailboxAddress":"shared-mailbox@example.co.uk","pubsubAudience":"https://api.example.co.uk/api/v1/webhooks/providers/REPLACE/google","pubsubServiceAccountEmail":"businessos-push@example-project.iam.gserviceaccount.com","pubsubTopic":"projects/REPLACE/topics/businessos-gmail","calendarId":"primary"},"whatsapp-main":{"provider":"WHATSAPP_BUSINESS","graphApiVersion":"vREPLACE.0","accessToken":"REPLACE","appSecret":"REPLACE_WITH_META_APP_SECRET","phoneNumberId":"REPLACE","verifyToken":"REPLACE_WITH_16_OR_MORE_RANDOM_CHARACTERS","defaultTemplateName":"businessos_update","defaultTemplateLanguage":"en_GB"}}'

# Gate L does not require OpenAI. Existing non-AI work continues normally when
# OPENAI_AGENT_ENABLED=false. Approved AI proposals become drafts only; sending
# still requires a human with communications.send.
OPENAI_AGENT_ENABLED=false
