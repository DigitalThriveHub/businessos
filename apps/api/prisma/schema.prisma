model Organisation {
  id          String             @id(map: "pk_organisations") @default(uuid()) @map("id") @db.Uuid
  slug        String             @unique(map: "uq_organisations_slug") @map("slug") @db.VarChar(80)
  name        String             @map("name") @db.VarChar(200)
  legalName   String?            @map("legal_name") @db.VarChar(250)
  status      OrganisationStatus @default(PROVISIONING) @map("status")
  timezone    String             @default("Europe/London") @map("timezone") @db.VarChar(64)
  locale      String             @default("en-GB") @map("locale") @db.VarChar(16)
  countryCode String             @default("GB") @map("country_code") @db.Char(2)
  metadata    Json?              @map("metadata")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(6)

  settings                  OrganisationSetting[]
  memberships               OrganisationMembership[]
  departments               Department[]
  departmentMemberships     DepartmentMembership[]
  teams                     Team[]
  teamMemberships           TeamMembership[]
  roles                     Role[]
  roleAssignments           RoleAssignment[]
  invitations               Invitation[]
  userSessions              UserSession[]
  supportAccessGrants       SupportAccessGrant[]
  auditEvents               AuditEvent[]
  securityEvents            SecurityEvent[]
  enquiries                 Enquiry[]
  jobProfiles               JobProfile[]
  jobProfileDuties          JobProfileDuty[]
  kpiDefinitions            KpiDefinition[]
  jobProfileKpis            JobProfileKpi[]
  agentProfiles             AgentProfile[]
  agentPolicies             AgentPolicy[]
  workforceAssignments      WorkforceAssignment[]
  workforceAssignmentKpis   WorkforceAssignmentKpi[]
  invitationOnboardingPlans InvitationOnboardingPlan[]
  invitationOnboardingRoles InvitationOnboardingRole[]
  invitationOnboardingKpis  InvitationOnboardingKpi[]
  numberSequences           OrganisationNumberSequence[]
  clients                   Client[]
  matters                   Matter[]
  matterParties             MatterParty[]
  matterComplianceRecords   MatterCompliance[]
  matterStatusHistory       MatterStatusHistory[]
  enquiryConversions        EnquiryConversion[]
  matterTasks               MatterTask[]
  matterDeadlines           MatterDeadline[]
  documentRequests          DocumentRequest[]
  documentRequestItems      DocumentRequestItem[]
  matterDocuments           MatterDocument[]
  matterDocumentVersions    MatterDocumentVersion[]
  matterTimelineEvents      MatterTimelineEvent[]
  workflowDefinitions       WorkflowDefinition[]
  workflowVersions          WorkflowVersion[]
  workflowRuns              WorkflowRun[]
  workflowActions           WorkflowAction[]
  slaPolicies               SlaPolicy[]
  slaInstances              SlaInstance[]
  escalationRules           EscalationRule[]
  escalationEvents          EscalationEvent[]
  approvalRequests          ApprovalRequest[]
  approvalDecisions         ApprovalDecision[]
  pilotAcceptanceEvidence   PilotAcceptanceEvidence[]
  pilotFeedback             PilotFeedback[]

  @@index([status, deletedAt], map: "ix_organisations_status_deleted")
  @@index([createdAt], map: "ix_organisations_created_at")
  @@map("organisations")
}

model OrganisationSetting {
  id              String    @id(map: "pk_organisation_settings") @default(uuid()) @map("id") @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  key             String    @map("key") @db.VarChar(120)
  value           Json?     @map("value")
  secretReference String?   @map("secret_reference") @db.VarChar(500)
  isSensitive     Boolean   @default(false) @map("is_sensitive")
  version         Int       @default(1) @map("version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_org_settings_organisation")

  @@unique([organisationId, key], map: "uq_org_settings_org_key")
  @@index([organisationId, deletedAt], map: "ix_org_settings_org_deleted")
  @@map("organisation_settings")
}

model UserProfile {
  /// This ID is the same UUID as Supabase Auth's auth.users.id.
  /// Add the cross-schema FK to auth.users(id) in the customised SQL migration.
  id             String            @id(map: "pk_user_profiles") @map("id") @db.Uuid
  email          String            @map("email") @db.VarChar(320)
  displayName    String?           @map("display_name") @db.VarChar(200)
  firstName      String?           @map("first_name") @db.VarChar(100)
  lastName       String?           @map("last_name") @db.VarChar(100)
  avatarPath     String?           @map("avatar_path") @db.VarChar(500)
  status         UserProfileStatus @default(ACTIVE) @map("status")
  locale         String            @default("en-GB") @map("locale") @db.VarChar(16)
  timezone       String            @default("Europe/London") @map("timezone") @db.VarChar(64)
  isPlatformUser Boolean           @default(false) @map("is_platform_user")
  lastSeenAt     DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  metadata       Json?             @map("metadata")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organisationMemberships          OrganisationMembership[]
  roleAssignments                  RoleAssignment[]
  grantedRoleAssignments           RoleAssignment[]           @relation("RoleAssignmentGrantedBy")
  revokedRoleAssignments           RoleAssignment[]           @relation("RoleAssignmentRevokedBy")
  invitationsSent                  Invitation[]               @relation("InvitationInvitedBy")
  invitationsAccepted              Invitation[]               @relation("InvitationAcceptedBy")
  invitationsRevoked               Invitation[]               @relation("InvitationRevokedBy")
  userSessions                     UserSession[]              @relation("SessionOwner")
  revokedUserSessions              UserSession[]              @relation("SessionRevokedBy")
  supportAccessAsGrantee           SupportAccessGrant[]       @relation("SupportAccessGrantee")
  supportAccessRequested           SupportAccessGrant[]       @relation("SupportAccessRequestedBy")
  supportAccessApproved            SupportAccessGrant[]       @relation("SupportAccessApprovedBy")
  supportAccessRevoked             SupportAccessGrant[]       @relation("SupportAccessRevokedBy")
  auditEventsAsActor               AuditEvent[]               @relation("AuditActorUser")
  auditEventsAsSubject             AuditEvent[]               @relation("AuditSubjectUser")
  securityEventsAsActor            SecurityEvent[]            @relation("SecurityActorUser")
  securityEventsAsSubject          SecurityEvent[]            @relation("SecuritySubjectUser")
  securityAcknowledged             SecurityEvent[]            @relation("SecurityAcknowledgedBy")
  securityResolved                 SecurityEvent[]            @relation("SecurityResolvedBy")
  assignedEnquiries                Enquiry[]                  @relation("EnquiryAssignedTo")
  createdEnquiries                 Enquiry[]                  @relation("EnquiryCreatedBy")
  updatedEnquiries                 Enquiry[]                  @relation("EnquiryUpdatedBy")
  jobProfilesCreated               JobProfile[]               @relation("JobProfileCreatedBy")
  jobProfilesUpdated               JobProfile[]               @relation("JobProfileUpdatedBy")
  kpiDefinitionsCreated            KpiDefinition[]            @relation("KpiDefinitionCreatedBy")
  kpiDefinitionsUpdated            KpiDefinition[]            @relation("KpiDefinitionUpdatedBy")
  agentProfilesCreated             AgentProfile[]             @relation("AgentProfileCreatedBy")
  agentProfilesUpdated             AgentProfile[]             @relation("AgentProfileUpdatedBy")
  workforceAssignmentsCreated      WorkforceAssignment[]      @relation("WorkforceAssignmentCreatedBy")
  workforceAssignmentsUpdated      WorkforceAssignment[]      @relation("WorkforceAssignmentUpdatedBy")
  workforceAssignmentsEnded        WorkforceAssignment[]      @relation("WorkforceAssignmentEndedBy")
  workforceAssignmentKpisCreated   WorkforceAssignmentKpi[]   @relation("WorkforceAssignmentKpiCreatedBy")
  invitationOnboardingPlansCreated InvitationOnboardingPlan[] @relation("InvitationOnboardingPlanCreatedBy")
  assignedClients                  Client[]                   @relation("ClientAssignedTo")
  clientsCreated                   Client[]                   @relation("ClientCreatedBy")
  clientsUpdated                   Client[]                   @relation("ClientUpdatedBy")
  assignedMatters                  Matter[]                   @relation("MatterAssignedTo")
  supervisedMatters                Matter[]                   @relation("MatterSupervisor")
  mattersCreated                   Matter[]                   @relation("MatterCreatedBy")
  mattersUpdated                   Matter[]                   @relation("MatterUpdatedBy")
  matterComplianceCreated          MatterCompliance[]         @relation("MatterComplianceCreatedBy")
  matterComplianceUpdated          MatterCompliance[]         @relation("MatterComplianceUpdatedBy")
  conflictChecksCompleted          MatterCompliance[]         @relation("MatterConflictCheckedBy")
  amlChecksCompleted               MatterCompliance[]         @relation("MatterAmlCheckedBy")
  riskReviewsCompleted             MatterCompliance[]         @relation("MatterRiskReviewedBy")
  matterStatusChanges              MatterStatusHistory[]      @relation("MatterStatusChangedBy")
  enquiryConversions               EnquiryConversion[]        @relation("EnquiryConvertedBy")
  assignedMatterTasks              MatterTask[]               @relation("MatterTaskAssignedTo")
  completedMatterTasks             MatterTask[]               @relation("MatterTaskCompletedBy")
  cancelledMatterTasks             MatterTask[]               @relation("MatterTaskCancelledBy")
  matterTasksCreated               MatterTask[]               @relation("MatterTaskCreatedBy")
  matterTasksUpdated               MatterTask[]               @relation("MatterTaskUpdatedBy")
  ownedMatterDeadlines             MatterDeadline[]           @relation("MatterDeadlineOwner")
  satisfiedMatterDeadlines         MatterDeadline[]           @relation("MatterDeadlineSatisfiedBy")
  cancelledMatterDeadlines         MatterDeadline[]           @relation("MatterDeadlineCancelledBy")
  matterDeadlinesCreated           MatterDeadline[]           @relation("MatterDeadlineCreatedBy")
  matterDeadlinesUpdated           MatterDeadline[]           @relation("MatterDeadlineUpdatedBy")
  documentRequestsSent             DocumentRequest[]          @relation("DocumentRequestSentBy")
  documentRequestsCancelled        DocumentRequest[]          @relation("DocumentRequestCancelledBy")
  documentRequestsCreated          DocumentRequest[]          @relation("DocumentRequestCreatedBy")
  documentRequestsUpdated          DocumentRequest[]          @relation("DocumentRequestUpdatedBy")
  matterDocumentsCreated           MatterDocument[]           @relation("MatterDocumentCreatedBy")
  matterDocumentsUpdated           MatterDocument[]           @relation("MatterDocumentUpdatedBy")
  matterDocumentVersionsUploaded   MatterDocumentVersion[]    @relation("MatterDocumentVersionUploadedBy")
  matterTimelineEvents             MatterTimelineEvent[]      @relation("MatterTimelineActor")
  pilotAcceptancesTested           PilotAcceptanceEvidence[]  @relation("PilotAcceptanceTestedBy")
  pilotFeedbackReported            PilotFeedback[]            @relation("PilotFeedbackReporter")
  pilotFeedbackResolved            PilotFeedback[]            @relation("PilotFeedbackResolvedBy")

  @@index([email], map: "ix_user_profiles_email")
  @@index([status, deletedAt], map: "ix_user_profiles_status_deleted")
  @@index([isPlatformUser, status], map: "ix_user_profiles_platform_status")
  @@map("user_profiles")
}

model OrganisationMembership {
  id             String           @id(map: "pk_organisation_memberships") @default(uuid()) @map("id") @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userProfileId  String           @map("user_profile_id") @db.Uuid
  status         MembershipStatus @default(INVITED) @map("status")
  jobTitle       String?          @map("job_title") @db.VarChar(160)
  employeeRef    String?          @map("employee_ref") @db.VarChar(100)
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(6)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  suspendedAt    DateTime?        @map("suspended_at") @db.Timestamptz(6)
  suspensionNote String?          @map("suspension_note") @db.Text
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(6)
