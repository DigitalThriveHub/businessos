  actorUser          UserProfile?        @relation("SecurityActorUser", fields: [actorUserProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_security_events_actor_user")
  subjectUser        UserProfile?        @relation("SecuritySubjectUser", fields: [subjectUserProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_security_events_subject_user")
