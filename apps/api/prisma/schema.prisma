  updatedBy    UserProfile?       @relation("EnquiryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  sourceClient Client?            @relation("ClientSourceEnquiry")
  sourceMatter Matter?            @relation("MatterSourceEnquiry")
  conversion   EnquiryConversion? @relation("EnquiryConversionSource")

  @@unique([id, organisationId], map: "uq_enquiries_id_org")
