model AuditEvent {
  id                   String         @id(map: "pk_audit_events") @default(uuid()) @map("id") @db.Uuid
  occurredAt           DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organisationId       String?        @map("organisation_id") @db.Uuid
  actorType            AuditActorType @map("actor_type")
  actorUserProfileId   String?        @map("actor_user_profile_id") @db.Uuid
  actorIdentifier      String?        @map("actor_identifier") @db.VarChar(200)
  subjectUserProfileId String?        @map("subject_user_profile_id") @db.Uuid
  userSessionId        String?        @map("user_session_id") @db.Uuid
  supportAccessGrantId String?        @map("support_access_grant_id") @db.Uuid
  requestId            String?        @map("request_id") @db.VarChar(100)
  correlationId        String?        @map("correlation_id") @db.VarChar(100)
  causationId          String?        @map("causation_id") @db.VarChar(100)
  source               String         @map("source") @db.VarChar(80)
  action               String         @map("action") @db.VarChar(160)
  resourceType         String         @map("resource_type") @db.VarChar(120)
  resourceId           String?        @map("resource_id") @db.VarChar(160)
  outcome              AuditOutcome   @map("outcome")
  reason               String?        @map("reason") @db.Text
  ipAddress            String?        @map("ip_address") @db.Inet
  userAgent            String?        @map("user_agent") @db.Text
  previousValue        Json?          @map("previous_value")
  newValue             Json?          @map("new_value")
  metadata             Json?          @map("metadata")
  previousHash         String?        @map("previous_hash") @db.VarChar(128)
  eventHash            String?        @unique(map: "uq_audit_events_event_hash") @map("event_hash") @db.VarChar(128)

  organisation       Organisation?       @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_audit_events_organisation")
  actorUser          UserProfile?        @relation("AuditActorUser", fields: [actorUserProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_audit_events_actor_user")
  subjectUser        UserProfile?        @relation("AuditSubjectUser", fields: [subjectUserProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_audit_events_subject_user")
  userSession        UserSession?        @relation(fields: [userSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_audit_events_session")
  supportAccessGrant SupportAccessGrant? @relation(fields: [supportAccessGrantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_audit_events_support_grant")

  @@index([organisationId, occurredAt(sort: Desc)], map: "ix_audit_events_org_occurred")
  @@index([actorUserProfileId, occurredAt(sort: Desc)], map: "ix_audit_events_actor_occurred")
  @@index([subjectUserProfileId, occurredAt(sort: Desc)], map: "ix_audit_events_subject_occurred")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "ix_audit_events_resource_occurred")
  @@index([correlationId], map: "ix_audit_events_correlation")
  @@index([action, outcome, occurredAt(sort: Desc)], map: "ix_audit_events_action_outcome")
  @@map("audit_events")
}

