  @@index([actorUserProfileId, occurredAt(sort: Desc)], map: "ix_security_events_actor")
  @@index([subjectUserProfileId, occurredAt(sort: Desc)], map: "ix_security_events_subject")
  @@index([eventType, occurredAt(sort: Desc)], map: "ix_security_events_type")
