enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION_BOOKED
  CONVERTED
  CLOSED
  SPAM
}

enum EnquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Enquiry {
  id               String  @id @default(uuid()) @db.Uuid
  organisationId   String  @map("organisation_id") @db.Uuid
  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid

  firstName   String  @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)
  email       String? @db.VarChar(320)
  phone       String? @db.VarChar(50)
  country     String? @db.VarChar(100)
  serviceType String? @map("service_type") @db.VarChar(160)
  message     String? @db.Text

  source   String?         @db.VarChar(100)
  status   EnquiryStatus   @default(NEW)
  priority EnquiryPriority @default(NORMAL)

  nextFollowUpAt  DateTime? @map("next_follow_up_at") @db.Timestamptz(6)
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6)
  convertedAt     DateTime? @map("converted_at") @db.Timestamptz(6)

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignedTo   UserProfile? @relation("EnquiryAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy    UserProfile? @relation("EnquiryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    UserProfile? @relation("EnquiryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, createdAt(sort: Desc)])
  @@index([organisationId, assignedToUserId, status])
  @@index([organisationId, email])
  @@index([organisationId, phone])
  @@index([organisationId, nextFollowUpAt])
  @@map("enquiries")
}
