generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganisationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organisation_status")
}

enum UserProfileStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_profile_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT

  @@map("membership_status")
}

enum RoleScope {
  PLATFORM
  ORGANISATION
  DEPARTMENT
  TEAM

  @@map("role_scope")
}

enum AssignmentScope {
  PLATFORM
  ORGANISATION
  DEPARTMENT
  TEAM

  @@map("assignment_scope")
}

enum PermissionDataScope {
  OWN
  ASSIGNED
  TEAM
  DEPARTMENT
  ORGANISATION
  SHARED
  PLATFORM

  @@map("permission_data_scope")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("session_status")
}

enum AuthenticationAssuranceLevel {
  AAL1
  AAL2

  @@map("authentication_assurance_level")
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  DENIED
  REVOKED
  EXPIRED

  @@map("support_access_status")
}

enum AuditActorType {
  USER
  AI_AGENT
  SERVICE
  SUPPORT
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  PARTIAL

  @@map("audit_outcome")
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("security_severity")
}

enum SecurityEventStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED

  @@map("security_event_status")
}

model Organisation {
  id          String             @id(map: "pk_organisations") @default(uuid()) @map("id") @db.Uuid
  slug        String             @unique(map: "uq_organisations_slug") @map("slug") @db.VarChar(80)
  name        String             @map("name") @db.VarChar(200)
  legalName   String?            @map("legal_name") @db.VarChar(250)
  status      OrganisationStatus @default(PROVISIONING) @map("status")
  timezone    String             @default("Europe/London") @map("timezone") @db.VarChar(64)
  locale      String             @default("en-GB") @map("locale") @db.VarChar(16)
  countryCode String             @default("GB") @map("country_code") @db.Char(2)
  metadata    Json?              @map("metadata")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(6)

  settings              OrganisationSetting[]
  memberships           OrganisationMembership[]
  departments           Department[]
  departmentMemberships DepartmentMembership[]
  teams                 Team[]
  teamMemberships       TeamMembership[]
  roles                 Role[]
  roleAssignments       RoleAssignment[]
  invitations           Invitation[]
  userSessions          UserSession[]
  supportAccessGrants   SupportAccessGrant[]
  auditEvents           AuditEvent[]
  securityEvents        SecurityEvent[]
  enquiries             Enquiry[]

  @@index([status, deletedAt], map: "ix_organisations_status_deleted")
  @@index([createdAt], map: "ix_organisations_created_at")
  @@map("organisations")
}

model OrganisationSetting {
  id              String    @id(map: "pk_organisation_settings") @default(uuid()) @map("id") @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  key             String    @map("key") @db.VarChar(120)
  value           Json?     @map("value")
  secretReference String?   @map("secret_reference") @db.VarChar(500)
  isSensitive     Boolean   @default(false) @map("is_sensitive")
  version         Int       @default(1) @map("version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_org_settings_organisation")

  @@unique([organisationId, key], map: "uq_org_settings_org_key")
  @@index([organisationId, deletedAt], map: "ix_org_settings_org_deleted")
  @@map("organisation_settings")
}

model UserProfile {
  /// This ID is the same UUID as Supabase Auth's auth.users.id.
  /// Add the cross-schema FK to auth.users(id) in the customised SQL migration.
  id             String            @id(map: "pk_user_profiles") @map("id") @db.Uuid
  email          String            @map("email") @db.VarChar(320)
  displayName    String?           @map("display_name") @db.VarChar(200)
  firstName      String?           @map("first_name") @db.VarChar(100)
  lastName       String?           @map("last_name") @db.VarChar(100)
  avatarPath     String?           @map("avatar_path") @db.VarChar(500)
  status         UserProfileStatus @default(ACTIVE) @map("status")
  locale         String            @default("en-GB") @map("locale") @db.VarChar(16)
  timezone       String            @default("Europe/London") @map("timezone") @db.VarChar(64)
  isPlatformUser Boolean           @default(false) @map("is_platform_user")
  lastSeenAt     DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  metadata       Json?             @map("metadata")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organisationMemberships OrganisationMembership[]
  roleAssignments         RoleAssignment[]
  grantedRoleAssignments  RoleAssignment[]         @relation("RoleAssignmentGrantedBy")
  revokedRoleAssignments  RoleAssignment[]         @relation("RoleAssignmentRevokedBy")
  invitationsSent         Invitation[]             @relation("InvitationInvitedBy")
  invitationsAccepted     Invitation[]             @relation("InvitationAcceptedBy")
  invitationsRevoked      Invitation[]             @relation("InvitationRevokedBy")
  userSessions            UserSession[]            @relation("SessionOwner")
  revokedUserSessions     UserSession[]            @relation("SessionRevokedBy")
  supportAccessAsGrantee  SupportAccessGrant[]     @relation("SupportAccessGrantee")
  supportAccessRequested  SupportAccessGrant[]     @relation("SupportAccessRequestedBy")
  supportAccessApproved   SupportAccessGrant[]     @relation("SupportAccessApprovedBy")
  supportAccessRevoked    SupportAccessGrant[]     @relation("SupportAccessRevokedBy")
  auditEventsAsActor      AuditEvent[]             @relation("AuditActorUser")
  auditEventsAsSubject    AuditEvent[]             @relation("AuditSubjectUser")
  securityEventsAsActor   SecurityEvent[]          @relation("SecurityActorUser")
  securityEventsAsSubject SecurityEvent[]          @relation("SecuritySubjectUser")
  securityAcknowledged    SecurityEvent[]          @relation("SecurityAcknowledgedBy")
  securityResolved        SecurityEvent[]          @relation("SecurityResolvedBy")
  assignedEnquiries       Enquiry[]                @relation("EnquiryAssignedTo")
  createdEnquiries        Enquiry[]                @relation("EnquiryCreatedBy")
  updatedEnquiries        Enquiry[]                @relation("EnquiryUpdatedBy")

  @@index([email], map: "ix_user_profiles_email")
  @@index([status, deletedAt], map: "ix_user_profiles_status_deleted")
  @@index([isPlatformUser, status], map: "ix_user_profiles_platform_status")
  @@map("user_profiles")
}

model OrganisationMembership {
  id             String           @id(map: "pk_organisation_memberships") @default(uuid()) @map("id") @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userProfileId  String           @map("user_profile_id") @db.Uuid
  status         MembershipStatus @default(INVITED) @map("status")
  jobTitle       String?          @map("job_title") @db.VarChar(160)
  employeeRef    String?          @map("employee_ref") @db.VarChar(100)
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(6)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  suspendedAt    DateTime?        @map("suspended_at") @db.Timestamptz(6)
  suspensionNote String?          @map("suspension_note") @db.Text
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_org_memberships_organisation")
  userProfile           UserProfile            @relation(fields: [userProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_org_memberships_user")
  departmentMemberships DepartmentMembership[]
  teamMemberships       TeamMembership[]
  roleAssignments       RoleAssignment[]
  invitations           Invitation[]
  userSessions          UserSession[]

  @@unique([organisationId, userProfileId], map: "uq_org_memberships_org_user")
  @@unique([id, organisationId], map: "uq_org_memberships_id_org")
  @@unique([id, organisationId, userProfileId], map: "uq_org_memberships_id_org_user")
  @@index([userProfileId, status, deletedAt], map: "ix_org_memberships_user_status")
  @@index([organisationId, status, deletedAt], map: "ix_org_memberships_org_status")
  @@map("organisation_memberships")
}

model Department {
  id             String    @id(map: "pk_departments") @default(uuid()) @map("id") @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String    @map("name") @db.VarChar(160)
  code           String?   @map("code") @db.VarChar(50)
  description    String?   @map("description") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_departments_organisation")
  parent          Department?            @relation("DepartmentHierarchy", fields: [parentId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_departments_parent")
  children        Department[]           @relation("DepartmentHierarchy")
  memberships     DepartmentMembership[]
  teams           Team[]
  roleAssignments RoleAssignment[]

  @@unique([id, organisationId], map: "uq_departments_id_org")
  @@unique([organisationId, name], map: "uq_departments_org_name")
  @@unique([organisationId, code], map: "uq_departments_org_code")
  @@index([organisationId, isActive, deletedAt], map: "ix_departments_org_active")
  @@index([organisationId, parentId], map: "ix_departments_org_parent")
  @@map("departments")
}

model DepartmentMembership {
  id                       String    @id(map: "pk_department_memberships") @default(uuid()) @map("id") @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  departmentId             String    @map("department_id") @db.Uuid
  organisationMembershipId String    @map("organisation_membership_id") @db.Uuid
  isManager                Boolean   @default(false) @map("is_manager")
  startsAt                 DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt                   DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation           Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_dept_memberships_organisation")
  department             Department             @relation(fields: [departmentId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_dept_memberships_department")
  organisationMembership OrganisationMembership @relation(fields: [organisationMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_dept_memberships_org_member")

  @@unique([departmentId, organisationMembershipId], map: "uq_dept_memberships_dept_member")
  @@index([organisationId, organisationMembershipId, deletedAt], map: "ix_dept_memberships_org_member")
  @@index([organisationId, departmentId, isManager, deletedAt], map: "ix_dept_memberships_org_dept")
  @@map("department_memberships")
}

model Team {
  id             String    @id(map: "pk_teams") @default(uuid()) @map("id") @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  name           String    @map("name") @db.VarChar(160)
  code           String?   @map("code") @db.VarChar(50)
  description    String?   @map("description") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_teams_organisation")
  department      Department?      @relation(fields: [departmentId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_teams_department")
  memberships     TeamMembership[]
  roleAssignments RoleAssignment[]

  @@unique([id, organisationId], map: "uq_teams_id_org")
  @@unique([organisationId, name], map: "uq_teams_org_name")
  @@unique([organisationId, code], map: "uq_teams_org_code")
  @@index([organisationId, departmentId, isActive, deletedAt], map: "ix_teams_org_department")
  @@map("teams")
}

model TeamMembership {
  id                       String    @id(map: "pk_team_memberships") @default(uuid()) @map("id") @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  teamId                   String    @map("team_id") @db.Uuid
  organisationMembershipId String    @map("organisation_membership_id") @db.Uuid
  isLead                   Boolean   @default(false) @map("is_lead")
  startsAt                 DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt                   DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation           Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_team_memberships_organisation")
  team                   Team                   @relation(fields: [teamId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_team_memberships_team")
  organisationMembership OrganisationMembership @relation(fields: [organisationMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_team_memberships_org_member")

  @@unique([teamId, organisationMembershipId], map: "uq_team_memberships_team_member")
  @@index([organisationId, organisationMembershipId, deletedAt], map: "ix_team_memberships_org_member")
  @@index([organisationId, teamId, isLead, deletedAt], map: "ix_team_memberships_org_team")
  @@map("team_memberships")
}

model Role {
  id             String    @id(map: "pk_roles") @default(uuid()) @map("id") @db.Uuid
  organisationId String?   @map("organisation_id") @db.Uuid
  key            String    @map("key") @db.VarChar(120)
  name           String    @map("name") @db.VarChar(160)
  description    String?   @map("description") @db.Text
  scope          RoleScope @map("scope")
  isSystem       Boolean   @default(false) @map("is_system")
  isAssignable   Boolean   @default(true) @map("is_assignable")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_roles_organisation")
  permissions  RolePermission[]
  assignments  RoleAssignment[]

  @@unique([organisationId, key], map: "uq_roles_org_key")
  @@index([organisationId, scope, deletedAt], map: "ix_roles_org_scope")
  @@index([isSystem, scope], map: "ix_roles_system_scope")
  @@map("roles")
}

model Permission {
  id          String               @id(map: "pk_permissions") @default(uuid()) @map("id") @db.Uuid
  key         String               @unique(map: "uq_permissions_key") @map("key") @db.VarChar(180)
  name        String               @map("name") @db.VarChar(180)
  description String?              @map("description") @db.Text
  resource    String               @map("resource") @db.VarChar(100)
  action      String               @map("action") @db.VarChar(80)
  dataScope   PermissionDataScope? @map("data_scope")
  isSensitive Boolean              @default(false) @map("is_sensitive")
  requiresMfa Boolean              @default(false) @map("requires_mfa")
  allowsAiUse Boolean              @default(false) @map("allows_ai_use")
  isActive    Boolean              @default(true) @map("is_active")
  metadata    Json?                @map("metadata")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource, action, dataScope, isActive], map: "ix_permissions_resource_action")
  @@index([resource, isActive, deletedAt], map: "ix_permissions_resource_active")
  @@index([allowsAiUse, isActive], map: "ix_permissions_ai_active")
  @@map("permissions")
}

model RolePermission {
  id           String   @id(map: "pk_role_permissions") @default(uuid()) @map("id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_permissions_role")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_permissions_permission")

  @@unique([roleId, permissionId], map: "uq_role_permissions_role_permission")
  @@index([permissionId, roleId], map: "ix_role_permissions_permission_role")
  @@map("role_permissions")
}

model RoleAssignment {
  id                       String          @id(map: "pk_role_assignments") @default(uuid()) @map("id") @db.Uuid
  roleId                   String          @map("role_id") @db.Uuid
  userProfileId            String          @map("user_profile_id") @db.Uuid
  organisationId           String?         @map("organisation_id") @db.Uuid
  organisationMembershipId String?         @map("organisation_membership_id") @db.Uuid
  departmentId             String?         @map("department_id") @db.Uuid
  teamId                   String?         @map("team_id") @db.Uuid
  scope                    AssignmentScope @map("scope")
  validFrom                DateTime        @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil               DateTime?       @map("valid_until") @db.Timestamptz(6)
  reason                   String?         @map("reason") @db.Text
  grantedByUserProfileId   String?         @map("granted_by_user_profile_id") @db.Uuid
  revokedAt                DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revokedByUserProfileId   String?         @map("revoked_by_user_profile_id") @db.Uuid
  revocationReason         String?         @map("revocation_reason") @db.Text
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?       @map("deleted_at") @db.Timestamptz(6)

  role                   Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_assignments_role")
  userProfile            UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_assignments_user")
  organisation           Organisation?           @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_assignments_org")
  organisationMembership OrganisationMembership? @relation(fields: [organisationMembershipId, organisationId, userProfileId], references: [id, organisationId, userProfileId], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_assignments_org_member")
  department             Department?             @relation(fields: [departmentId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_assignments_department")
  team                   Team?                   @relation(fields: [teamId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_role_assignments_team")
  grantedBy              UserProfile?            @relation("RoleAssignmentGrantedBy", fields: [grantedByUserProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_role_assignments_granted_by")
  revokedBy              UserProfile?            @relation("RoleAssignmentRevokedBy", fields: [revokedByUserProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_role_assignments_revoked_by")

  @@index([userProfileId, scope, revokedAt, validUntil], map: "ix_role_assignments_user_effective")
  @@index([organisationId, userProfileId, revokedAt, validUntil], map: "ix_role_assignments_org_user")
  @@index([organisationMembershipId, revokedAt], map: "ix_role_assignments_membership")
  @@index([departmentId, userProfileId, revokedAt], map: "ix_role_assignments_department")
  @@index([teamId, userProfileId, revokedAt], map: "ix_role_assignments_team")
  @@index([roleId, revokedAt, validUntil], map: "ix_role_assignments_role")
  @@map("role_assignments")
}

model Invitation {
  id                       String           @id(map: "pk_invitations") @default(uuid()) @map("id") @db.Uuid
  organisationId           String           @map("organisation_id") @db.Uuid
  organisationMembershipId String?          @map("organisation_membership_id") @db.Uuid
  email                    String           @map("email") @db.VarChar(320)
  tokenHash                String           @unique(map: "uq_invitations_token_hash") @map("token_hash") @db.VarChar(128)
  status                   InvitationStatus @default(PENDING) @map("status")
  invitedByUserProfileId   String           @map("invited_by_user_profile_id") @db.Uuid
  acceptedByUserProfileId  String?          @map("accepted_by_user_profile_id") @db.Uuid
  revokedByUserProfileId   String?          @map("revoked_by_user_profile_id") @db.Uuid
  expiresAt                DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt               DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt                DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revocationReason         String?          @map("revocation_reason") @db.Text
  metadata                 Json?            @map("metadata")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?        @map("deleted_at") @db.Timestamptz(6)

  organisation           Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_invitations_organisation")
  organisationMembership OrganisationMembership? @relation(fields: [organisationMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade, map: "fk_invitations_org_member")
  invitedBy              UserProfile             @relation("InvitationInvitedBy", fields: [invitedByUserProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_invitations_invited_by")
  acceptedBy             UserProfile?            @relation("InvitationAcceptedBy", fields: [acceptedByUserProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_invitations_accepted_by")
